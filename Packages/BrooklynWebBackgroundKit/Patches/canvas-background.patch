new file mode 100644
index 0000000..fbb909c
--- /dev/null
+++ b/patched/src/HighRefresh.ts
@@ -0,0 +1,157 @@
+type TransformSnapshot = readonly number[]
+type TransformProbe = () => TransformSnapshot | null
+
+let transformProbe: TransformProbe | null = null
+let previousAdvanceMS: number | null = null
+let previousTransform: TransformSnapshot | null = null
+let previousTransformMotionMS: number | null = null
+let manualAdvanceIntervals: number[] = []
+let transformMotionIntervals: number[] = []
+let hostActive = true
+let documentVisible = document.visibilityState === 'visible'
+let activityActive = hostActive && documentVisible
+let activitySegmentID = activityActive ? 1 : 0
+let telemetryStartedAtMS: number | null = null
+let activePeriodStartedAtMS: number | null = null
+let accumulatedActiveDurationMS = 0
+let activeSegmentCount = 0
+let suspensionCount = 0
+let suspensionReasons = new Set<string>()
+let schedulerDroppedSlots = 0
+let startedVisibilityState = document.visibilityState
+let sceneInstanceCount = 256
+let sceneGridDrawCalls = 1
+
+export const registerTransformProbe = (probe: TransformProbe) => {
+  transformProbe = probe
+  return () => {
+    if (transformProbe === probe) transformProbe = null
+  }
+}
+
+export const recordSceneMetrics = (
+  instanceCount: number,
+  gridDrawCalls = 1
+) => {
+  sceneInstanceCount = Math.max(0, Math.floor(instanceCount))
+  sceneGridDrawCalls = Math.max(0, Math.floor(gridDrawCalls))
+}
+
+export const highRefreshActivityState = () => ({
+  active: activityActive,
+  segmentID: activitySegmentID
+})
+
+export const resetHighRefreshTelemetry = (nowMS = performance.now()) => {
+  previousAdvanceMS = null
+  previousTransform = null
+  previousTransformMotionMS = null
+  manualAdvanceIntervals = []
+  transformMotionIntervals = []
+  telemetryStartedAtMS = nowMS
+  activePeriodStartedAtMS = activityActive ? nowMS : null
+  accumulatedActiveDurationMS = 0
+  activeSegmentCount = activityActive ? 1 : 0
+  suspensionCount = activityActive ? 0 : 1
+  suspensionReasons = new Set()
+  if (!hostActive) suspensionReasons.add('hostInactive')
+  if (!documentVisible) suspensionReasons.add('documentHidden')
+  schedulerDroppedSlots = 0
+  startedVisibilityState = document.visibilityState
+}
+
+export const markHighRefreshActivity = (
+  nextHostActive: boolean,
+  nextDocumentVisible: boolean,
+  nowMS = performance.now()
+) => {
+  hostActive = nextHostActive
+  documentVisible = nextDocumentVisible
+  const nextActive = hostActive && documentVisible
+
+  if (telemetryStartedAtMS !== null) {
+    if (!hostActive) suspensionReasons.add('hostInactive')
+    if (!documentVisible) suspensionReasons.add('documentHidden')
+  }
+
+  if (nextActive === activityActive) return
+
+  if (telemetryStartedAtMS !== null) {
+    if (activityActive && activePeriodStartedAtMS !== null) {
+      accumulatedActiveDurationMS += Math.max(
+        0,
+        nowMS - activePeriodStartedAtMS
+      )
+    }
+    if (nextActive) {
+      activeSegmentCount += 1
+    } else {
+      suspensionCount += 1
+    }
+    activePeriodStartedAtMS = nextActive ? nowMS : null
+  }
+
+  activityActive = nextActive
+  activitySegmentID += 1
+  previousAdvanceMS = null
+  previousTransform = null
+  previousTransformMotionMS = null
+}
+
+export const recordSchedulerDroppedSlots = (count: number) => {
+  schedulerDroppedSlots += Math.max(0, Math.floor(count))
+}
+
+export const recordManualAdvance = (completedAtMS: number) => {
+  if (!activityActive) return
+  if (previousAdvanceMS !== null) {
+    manualAdvanceIntervals.push(completedAtMS - previousAdvanceMS)
+  }
+  previousAdvanceMS = completedAtMS
+
+  const transform = transformProbe?.() ?? null
+  if (!transform) return
+
+  const moved =
+    previousTransform !== null &&
+    transform.some(
+      (component, index) =>
+        Math.abs(component - (previousTransform?.[index] ?? component)) > 1e-8
+    )
+  previousTransform = [...transform]
+  if (!moved) return
+
+  if (previousTransformMotionMS !== null) {
+    transformMotionIntervals.push(completedAtMS - previousTransformMotionMS)
+  }
+  previousTransformMotionMS = completedAtMS
+}
+
+export const highRefreshTelemetrySnapshot = (nowMS = performance.now()) => {
+  const wallDurationMS =
+    telemetryStartedAtMS === null ? 0 : nowMS - telemetryStartedAtMS
+  const openActiveDurationMS =
+    activityActive && activePeriodStartedAtMS !== null
+      ? nowMS - activePeriodStartedAtMS
+      : 0
+  const activeDurationMS = Math.max(
+    0,
+    accumulatedActiveDurationMS + openActiveDurationMS
+  )
+
+  return {
+    activeDurationMS,
+    activeSegmentCount,
+    endedVisibilityState: document.visibilityState,
+    manualAdvanceIntervals: [...manualAdvanceIntervals],
+    sceneGridDrawCalls,
+    sceneInstanceCount,
+    schedulerDroppedSlots,
+    startedVisibilityState,
+    suspendedDurationMS: Math.max(0, wallDurationMS - activeDurationMS),
+    suspensionCount,
+    suspensionReasons: [...suspensionReasons].sort(),
+    transformMotionIntervals: [...transformMotionIntervals],
+    wallDurationMS
+  }
+}
