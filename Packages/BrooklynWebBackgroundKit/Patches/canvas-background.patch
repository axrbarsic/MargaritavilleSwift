@@ -0,0 +1,57 @@
+import * as THREE from 'three'
+
+export interface BrooklynAppearance {
+  cellScale: number
+  hue: number
+  brightness: number
+  contrast: number
+}
+
+export const DONOR_HUE = 0.9502923976608187
+
+export const DEFAULT_APPEARANCE: BrooklynAppearance = {
+  cellScale: 1,
+  hue: DONOR_HUE,
+  brightness: 1,
+  contrast: 0
+}
+
+const clamp = (
+  value: unknown,
+  minimum: number,
+  maximum: number,
+  fallback: number
+) =>
+  typeof value === 'number' && Number.isFinite(value)
+    ? Math.min(maximum, Math.max(minimum, value))
+    : fallback
+
+export const normalizeAppearance = (
+  value: Partial<BrooklynAppearance> | null | undefined
+): BrooklynAppearance => ({
+  cellScale: clamp(value?.cellScale, 0.45, 1.25, DEFAULT_APPEARANCE.cellScale),
+  hue: clamp(value?.hue, 0, 1, DEFAULT_APPEARANCE.hue),
+  brightness: clamp(
+    value?.brightness,
+    0.45,
+    1.55,
+    DEFAULT_APPEARANCE.brightness
+  ),
+  contrast: clamp(value?.contrast, -0.5, 0.5, DEFAULT_APPEARANCE.contrast)
+})
+
+export const appearanceColor = (
+  donorColor: string,
+  appearance: BrooklynAppearance
+) => {
+  if (appearance.hue === DEFAULT_APPEARANCE.hue) {
+    return donorColor
+  }
+
+  const color = new THREE.Color(donorColor)
+  const hsl = { h: 0, s: 0, l: 0 }
+  color.getHSL(hsl)
+  const hue = (hsl.h + appearance.hue - DONOR_HUE + 1) % 1
+  color.setHSL(hue, hsl.s, hsl.l)
+  return `#${color.getHexString()}`
+}
