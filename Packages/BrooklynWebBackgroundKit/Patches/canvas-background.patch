@@ -0,0 +1,224 @@
+import { type BrooklynAppearance, normalizeAppearance } from './Appearance'
+import {
+  highRefreshActivityState,
+  highRefreshTelemetrySnapshot,
+  resetHighRefreshTelemetry
+} from './HighRefresh'
+
+type ActiveHandler = (active: boolean) => void
+type AppearanceHandler = (appearance: BrooklynAppearance) => void
+type HighRefreshHandler = (enabled: boolean) => void
+
+interface BrooklynWebWindow extends Window {
+  __brooklynSetActive?: ActiveHandler
+  __brooklynSetAppearance?: (appearance: Partial<BrooklynAppearance>) => void
+  __brooklynSetHighRefresh?: (enabled: boolean) => void
+  __brooklynStartTelemetry?: (durationMS?: number) => void
+  webkit?: {
+    messageHandlers?: {
+      brooklynLifecycle?: { postMessage: (message: unknown) => void }
+      brooklynTelemetry?: { postMessage: (message: unknown) => void }
+    }
+  }
+}
+
+const bridgeWindow = window as BrooklynWebWindow
+let runtimeReady = false
+let didPostRuntimeReady = false
+let bridgeInstalled = false
+
+const postRuntimeReadyIfPossible = () => {
+  const handler = bridgeWindow.webkit?.messageHandlers?.brooklynLifecycle
+  if (!runtimeReady || !bridgeInstalled || didPostRuntimeReady || !handler)
+    return
+  didPostRuntimeReady = true
+  handler.postMessage({ kind: 'ready', version: 1 })
+}
+
+export function markRuntimeReady() {
+  runtimeReady = true
+  postRuntimeReadyIfPossible()
+}
+
+const percentile = (sorted: number[], fraction: number) => {
+  if (sorted.length === 0) return null
+  const index = Math.min(
+    sorted.length - 1,
+    Math.max(0, Math.ceil(sorted.length * fraction) - 1)
+  )
+  return sorted[index]
+}
+
+const rounded = (value: number | null) =>
+  value === null || !Number.isFinite(value) ? null : Number(value.toFixed(3))
+
+const TARGET_INTERVAL_MS = 1_000 / 120
+const STALL_THRESHOLD_MS = 25
+const MISSED_SLOT_THRESHOLD_MS = 12.5
+const BURST_THRESHOLD_MS = TARGET_INTERVAL_MS / 2
+
+const cadenceMetrics = (intervals: number[]) => {
+  const sorted = [...intervals].sort((a, b) => a - b)
+  const medianMS = percentile(sorted, 0.5)
+  const p99MS = percentile(sorted, 0.99)
+  const maximumMS = sorted.length === 0 ? null : sorted[sorted.length - 1]
+  const observedActiveMS = intervals.reduce(
+    (total, interval) => total + interval,
+    0
+  )
+  return {
+    activeIntervalCount: intervals.length,
+    burstCount: intervals.filter(interval => interval < BURST_THRESHOLD_MS)
+      .length,
+    cadenceHz:
+      medianMS === null || medianMS <= 0 ? null : rounded(1_000 / medianMS),
+    effectiveCadenceHz:
+      observedActiveMS <= 0
+        ? null
+        : rounded((intervals.length * 1_000) / observedActiveMS),
+    maximumMS: rounded(maximumMS),
+    medianMS: rounded(medianMS),
+    missedSlotCount: intervals.filter(
+      interval => interval > MISSED_SLOT_THRESHOLD_MS
+    ).length,
+    missedSlotThresholdMS: rounded(MISSED_SLOT_THRESHOLD_MS),
+    observedActiveMS: rounded(observedActiveMS),
+    p99MS: rounded(p99MS),
+    sampleCount: intervals.length,
+    stallCount: intervals.filter(interval => interval > STALL_THRESHOLD_MS)
+      .length,
+    stallThresholdMS: rounded(STALL_THRESHOLD_MS)
+  }
+}
+
+export function installRuntimeBridge(
+  setActive: ActiveHandler,
+  setAppearance: AppearanceHandler,
+  setHighRefresh: HighRefreshHandler
+) {
+  let telemetryGeneration = 0
+  bridgeInstalled = true
+
+  bridgeWindow.__brooklynSetActive = setActive
+  bridgeWindow.__brooklynSetAppearance = appearance =>
+    setAppearance(normalizeAppearance(appearance))
+  bridgeWindow.__brooklynSetHighRefresh = enabled =>
+    setHighRefresh(enabled === true)
+  bridgeWindow.__brooklynStartTelemetry = (requestedDurationMS = 30_000) => {
+    const durationMS = Math.max(1_000, Math.min(60_000, requestedDurationMS))
+    const generation = ++telemetryGeneration
+    const intervals: number[] = []
+    const startedAt = performance.now()
+    let previousFrame: number | null = null
+    let previousActivitySegment: number | null = null
+    resetHighRefreshTelemetry()
+
+    const sample = (now: number) => {
+      if (generation !== telemetryGeneration) return
+
+      const activity = highRefreshActivityState()
+      if (
+        activity.active &&
+        previousFrame !== null &&
+        previousActivitySegment === activity.segmentID
+      ) {
+        intervals.push(now - previousFrame)
+      }
+      previousFrame = activity.active ? now : null
+      previousActivitySegment = activity.segmentID
+
+      if (now - startedAt < durationMS) {
+        requestAnimationFrame(sample)
+        return
+      }
+
+      const highRefresh = highRefreshTelemetrySnapshot(now)
+      const legacy = cadenceMetrics(intervals)
+      const manual = cadenceMetrics(highRefresh.manualAdvanceIntervals)
